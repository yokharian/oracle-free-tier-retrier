{
  "name": "oci-free-vm",
  "version": "0.3.2",
  "description": "Deploy an OCI VM and automatically retry when capacity is unavailable.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokharian/oracle-free-tier-retrier.git"
  },
  "bin": {
    "oci-free-vm": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "oci",
    "oracle",
    "oracle-cloud",
    "vm",
    "cli",
    "deploy",
    "retry",
    "capacity",
    "free-tier"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "oci-common": "^2.143.0",
    "oci-core": "^2.143.0",
    "oci-identity": "^2.143.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
