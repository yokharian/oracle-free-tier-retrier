# Copy this file to terraform.tfvars and fill in your values
# Usage: cp terraform.tfvars.example terraform.tfvars
# Get your compartment/tenancy OCID: oci iam compartment list
# Note: If no compartments exist, use your tenancy OCID from ~/.oci/config

region              = "us-ashburn-1"
compartment_id      = "ocid1.tenancy.oc1..your_tenancy_or_compartment_ocid"
availability_domain = "fNXZ:US-ASHBURN-AD-1"
instance_name       = "my-vm-instance"
instance_shape      = "VM.Standard.A1.Flex"
instance_ocpus      = 1
instance_memory_gbs = 6
instance_image_id   = "ocid1.image.oc1.iad..your_image_ocid"
assign_public_ip    = true
vcn_cidr            = "10.0.0.0/16"
subnet_cidr         = "10.0.0.0/24"
dns_label           = "myvcn"
ssh_public_key      = "ssh-ed25519 AAAA... your_email@example.com"
